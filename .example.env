# Telegram bot token from @BotFather.
BOT_TOKEN=123456:ABC-DEF

# Telegram user IDs allowed to use the bot, comma separated. Leave empty to
# allow anyone to use it.
ALLOWED_USERS=

# Local state: download metadata and other persistent bot data.
DB_PATH=data/songbot.db

# Persistent cache for checksum-validated yt-dlp, ffmpeg, and ffprobe binaries.
YTDLP_DIR=data/bin

# Temporary workspace for downloads. Files are deleted after they are sent.
WORK_DIR=/tmp/songbot

# Path to a yt-dlp executable to use instead of the managed one. Leave empty
# to let the app download and checksum-verify the version it was built against.
# This is the escape hatch for running a newer yt-dlp when YouTube breaks the
# extractor, without waiting for an app release.
YTDLP_PATH=

# Health and metrics endpoints.
HTTP_ADDR=:8080

# debug | info | warn | error
LOG_LEVEL=info

# Concurrent downloads across all users.
WORKERS=3

# Pending jobs accepted before new requests are rejected.
QUEUE_SIZE=64

# Per-user token bucket refill, in requests per hour.
USER_RATE_PER_HOUR=20

# Per-user burst allowance and maximum queued jobs for one user.
USER_BURST=3

# Refuse songs longer than this duration.
MAX_DURATION=20m

# Refuse files larger than this, in mebibytes. 50 is Telegram's Bot API upload
# ceiling and also the highest value accepted here.
MAX_FILE_SIZE_MB=50

# Maximum time allowed for one download.
DOWNLOAD_TIMEOUT=5m

# Audio container sent to Telegram.
AUDIO_FORMAT=m4a

# yt-dlp audio quality scale. 0 is best.
AUDIO_QUALITY=0

# Search results ranked against each other when picking a match for a query.
SEARCH_RESULTS=5
